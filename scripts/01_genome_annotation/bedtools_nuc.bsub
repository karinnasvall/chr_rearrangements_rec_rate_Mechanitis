#!/bin/bash
#BSUB -M 2000
#BSUB -R "select[mem>2000] rusage[mem=2000] span[hosts=1]"
#BSUB -n 2
#BSUB -q normal
#BSUB -J nuc[1-2]
#BSUB -o log/nuc.%J.%I.out
#BSUB -e log/nuc.%J.%I.err

tolid=$(sed -n -e ${LSB_JOBINDEX}p list_tolids.txt)

window=100000
# run this script in a folder where you want the output folder (eg 10_composition)
output_path=output
input_path=../pipeline/results/01_genomes/indexed/

genome=${tolid}_hap1.fa

echo "Processing $genome"

module load bedtools/2.31.1--hf5e1c6e_1

#gunzip ../${genome}
#samtools faidx ../${genome.*}
bedtools makewindows -g ${input_path}/${genome}.fai -w $window > ${input_path}/${tolid}_hap1_${window}_windows.bed
bedtools nuc -fi ${input_path}/${genome} -bed ${input_path}/${tolid}_hap1_${window}_windows.bed > ${output_path}/${tolid}_gc_content_${window}.txt
#gzip ../${genome%.*}
