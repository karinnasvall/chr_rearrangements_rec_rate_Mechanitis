#!/bin/bash
#BSUB -J concat_p2l
#BSUB -q normal
#BSUB -n 2
#BSUB -M 4000
#BSUB -R "select[mem>4000] rusage[mem=4000] span[hosts=1]"
#BSUB -o /data/tol/teams/meier/lustre/users/fv3/pedigree_polymnia/logs/7.2_concat/concat_%J.out
#BSUB -e /data/tol/teams/meier/lustre/users/fv3/pedigree_polymnia/logs/7.2_concat/concat_%J.err
#BSUB -w "ended(pileup2lik)"

set -euo pipefail

BASE_DIR="/data/tol/teams/meier/lustre/users/fv3/pedigree_polymnia"
CONTIGS_FILE="${BASE_DIR}/file_lists/polymnia_contigs_SUPER_noW.txt"

MP_OUT_DIR="${BASE_DIR}/7.1_pileup2lik_nextflow"
LOG_DIR="${BASE_DIR}/logs/7.2_concat"
mkdir -p "${LOG_DIR}"

cd "${MP_OUT_DIR}"

echo "Concatenating *.post.gz files in contig order..."

(
  first=1
  while read -r CONTIG; do
    zcat "${CONTIG}.post.gz"
  done < "${CONTIGS_FILE}"
) | awk 'NR==1 || $1!="CHR"' | gzip > all.post.gz

echo "Done. Output: ${MP_OUT_DIR}/all.post.gz"
